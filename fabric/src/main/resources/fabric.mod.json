{
  "schemaVersion": 1,
  "id": "terrassic",
  "version": "${version}",
  "name": "Terrassic",
  "description": "Real dinosaurs rebuilt from fossil references: 12 species from the tiny Compsognathus to the giant Brachiosaurus, males and females, eggs that hatch, taming, riding and archaic weapons.",
  "authors": [
    "Rodrigo Gomes (Grupo Permaneo)"
  ],
  "contact": {},
  "license": "All-Rights-Reserved",
  "icon": "assets/terrassic/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.terrassic.fabric.TerrassicFabric"
    ],
    "client": [
      "com.terrassic.fabric.client.EraFilterFabric"
    ]
  },
  "depends": {
    "fabricloader": ">=0.15.0",
    "minecraft": "~1.20.1",
    "java": ">=17",
    "architectury": ">=9.2.0",
    "geckolib": ">=4.4.0",
    "fabric-api": "*"
  },
  "mixins": [
    "terrassic.mixins.json"
  ]
